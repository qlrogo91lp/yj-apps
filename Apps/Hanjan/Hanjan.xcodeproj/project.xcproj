{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "../../Packages/YJKit",
    },
  ],
  "files": [
    { "path": "Hanjan-Info.plist" },
    { "kind": "folder", "path": "iOSApp", "target-membership": [ "Hanjan" ] },
    { "kind": "folder", "path": "WatchApp", "target-membership": [ "Hanjan Watch App" ] },
    { "kind": "folder", "path": "Shared", "target-membership": [ "Hanjan", "Hanjan Watch App" ] },
    { "kind": "folder", "path": "Common", "target-membership": [ "Hanjan", "Hanjan Watch App", "HanjanComplicationExtension", "HanjanLiveActivityExtension" ] },
    {
      "kind": "folder",
      "path": "ComplicationApp",
      "target-membership": [
        "HanjanComplicationExtension",
      ],
      "membership-exceptions": [
        {
          "target": "HanjanComplicationExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "LiveActivity",
      "target-membership": [
        "HanjanLiveActivityExtension",
      ],
      "membership-exceptions": [
        {
          "target": "HanjanLiveActivityExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "iosTests", "target-membership": [ "HanjanTests" ] },
    { "kind": "folder", "path": "watchosTests", "target-membership": [ "HanjanWatchTests" ] },
    {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        {
          "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework",
          "target-membership": [
            "HanjanComplicationExtension/frameworks",
            "HanjanLiveActivityExtension/frameworks",
          ],
        }, {
          "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework",
          "target-membership": [
            "HanjanComplicationExtension/frameworks",
            "HanjanLiveActivityExtension/frameworks",
          ],
        },
      ],
    }, {
      "path": "Hanjan.icon",
      "target-membership": [
        "Hanjan/resources",
        "Hanjan Watch App/resources",
        "HanjanComplicationExtension/resources",
        "HanjanLiveActivityExtension/resources",
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Hanjan.app", "id": "3903802A30A9D356004DA3A1", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Hanjan Watch App.app", "id": "3903846930A9D4E0004DA3A1", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "Hanjan/copy/Embed Watch Content", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/HanjanComplicationExtension.appex", "id": "3903847B30A9D58D004DA3A1", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Hanjan Watch App/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/HanjanLiveActivityExtension.appex", "id": "3903849330A9D606004DA3A1", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Hanjan/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/HanjanTests.xctest", "id": "390384AA30A9D7DB004DA3A1", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/HanjanWatchTests.xctest", "id": "390384B630A9D7F4004DA3A1", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Hanjan",
      "id": "3903802930A9D356004DA3A1",
      "product": "Products/Hanjan.app",
      "product-type": "application",
      "dependencies": [
        "Hanjan Watch App",
        "HanjanLiveActivityExtension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "package": "YJKit",
          "product-name": "ConnectivityCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "YJKit",
          "product-name": "PersistenceCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "Hanjan",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Hanjan.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "P2TU28W32L",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Hanjan-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "한잔",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "술자리 장소를 기록에 남기는 데 사용합니다.",
        "INFOPLIST_KEY_NSSupportsLiveActivities": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.yj.Hanjan",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1",
      },
    }, {
